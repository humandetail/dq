    "basis": "confirmed Q33",
    "thresholdResolver": {
      "readFirst": "GetUnitAbilityLevel(actualDamageSource,A007)",
      "firstBranch": "if Game_Mode==2 return3",
      "otherwise": "levels1..6 return5/6/7/8/9/12; unmatched level returns0",
      "outputUnit": "integer percentage points, unchanged from source resolver"
    },
    "probability": {
      "exact": "threshold/100",
      "drawLocation": "main damage dispatch after threshold resolution and before A007_Action1",
      "drawsPerQualifiedInvocation": 1,
      "zeroProbability": "still consume the existing single draw if caller gates pass",
      "additionalLevelRangeGate": false
    },
    "callerGate": "reaches A007 branch AND actual source A007 level>0 AND IsUnitIllusion(source)==false",
    "unchanged": "any damage, target and duration rules, repeated-paused rejection, expiry and original interactions"
  }
