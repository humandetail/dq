  "web_rules": {
    "target_relation": "enemy_of_source_owner_at_area_resolution; caller-explicit relationship policy has priority; three closed profiles use enemy",
    "geometry": {
      "dimensions": 2,
      "predicate": "(unit.x-center.x)^2+(unit.y-center.y)^2 <= radius^2",
      "collision_radius_added": false,
      "edge_inclusive": true,
      "air_and_structures": "included unless caller-specific filter excludes",
      "visibility_detection_height_los": "not implicit filters"
    },
    "snapshot": {
      "time": "immediate if delay=0; due time if positive",
      "order": "ascending persistent unit creation id (B04)",
      "initial_filters": [
        "exists",
        "alive",
        "enemy",
        "inside_closed_circle",
        "no_active_Aloc",
        "not_invulnerable",
        "not_MAGIC_against_magic_immune",
        "caller_target_filter"
      ],
      "before_each_child_recheck": [
        "exists",
        "alive",
        "active_Aloc",
        "invulnerable",
        "MAGIC_against_magic_immune"
      ],
      "not_rechecked": [
        "position",
        "allegiance",
        "caller spatial filter"
      ],
      "created_during_resolution": "excluded"
    },
    "magic_immunity": {
      "MAGIC": "skip before event",
      "NORMAL": "not rejected by magic immunity",
      "DIVINE": "not rejected by magic immunity",
      "other_types": "not classified by this baseline; require typed-damage contract",
      "attack_type": "preserve separately; not overwritten by damage_type"
    },
    "zero_delay": "synchronous; each child completes before next; all children finish before native returns; no TimerStart(0) scheduling",
    "positive_delay": {
      "capture": [
        "source_unit_ref",
        "center_x",
        "center_y",
        "radius",
        "amount",
        "attack",
        "ranged",
        "attack_type",
        "damage_type",
        "weapon_type"
      ],
      "schedule": "B05 microseconds and enqueue order",
      "target_query": "at due time",
      "dead_source": "continues if still exists",
      "removed_source_before_due": "cancel emission",
      "source_owner": "read at resolution"
    },
    "packet": "one area emission; same requested raw amount for every victim; no division by target count, no extra hit roll, no single-target spell-effect event or per-target cost; per-victim B03 typed mitigation and original damage pipeline",
    "source_attributes": "caller snapshots raw amount once; map event callbacks may read live source attributes normally",
    "invalid_inputs": "finite center/radius/amount/delay required; radius, delay and amount >=0; removed source invalid; false and no damage/queue mutation on invalid request; never clamp or invent radius",
    "zero_amount": "no damage events; caller continues normally; source trigger gates and RNG calls have already occurred",
    "negative_amount": "return false and emit no damage or delayed job; never convert to healing. No reachable negative call is established in the three closed profiles; i132/i134 explicitly return on P<=0, Dragonspawn has no local P>0 guard. Any future evidenced reachable negative formula requires an explicit skill rule instead of silent omission.",
    "return": "false for invalid request; true for accepted request even if no victim; positive delay returns acceptance, not eventual hit result"
  },
