  "authority": "Q24 authorizes explicit Web choices for researched but unverified engine behavior",
  "status": "specification-only; no original-client or game-runtime tests",
  "rules": {
    "B01": {
      "positiveArmorCoefficient": 0.018,
      "negativeArmorExponentialBase": 0.94,
      "negativeArmorFormula": "2 - 0.94 ** (-armor)",
      "retainOriginalGCorrection": true,
      "unverifiedChoice": "negative base remains 0.94 despite positive coefficient override"
    },
    "B02": {
      "recurrenceA": {
        "numerator": 7,
        "denominator": 5
      },
