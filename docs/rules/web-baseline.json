      },
      "extendKillTablesBeyond30": true,
      "unverifiedChoice": "per-entry flooring, not only final rounding"
    },
    "B03": {
      "eventInput": "after native mitigation applicable to that damage entry",
      "eventWrite": "replace current event amount; do not apply mitigation again at commit",
      "nestedEvents": "synchronous independent context stack; restore parent context only",
      "unverifiedChoice": "mitigation precedes event dispatcher; source damage-type classification remains required"
    },
    "B04": {
      "groupOrder": "ascending persistent unit creation sequence",
      "reuseRemovedSequence": false,
      "preserveQueryPredicates": true,
      "unverifiedChoice": "stable creation sequence substitutes unknown native enumeration order"
    },
    "B05": {
      "battleTimeUnit": "microsecond",
      "secondsToBattleTime": "nearest integer after multiplying by 1000000; halves round up",
      "eventSort": [
        "dueBattleTime",
        "enqueueSequence"
      ],
      "zeroDelay": "enqueue at current battle time; never inline",
      "periodicNextDue": "previous planned due + period, with new enqueue sequence",
      "cancel": "invalidate pending occurrence",
      "unverifiedChoice": "stable FIFO for same-time native timer events"
    }
  },
